# ==============================================================================
# HireSphere AI - Frontend Environment Configuration (.env)
# ==============================================================================
# All API endpoints, server ports, and configuration keys in ONE centralized place.

# ------------------------------------------------------------------------------
# 1. APPLICATION BRANDING & INFO
# ------------------------------------------------------------------------------
VITE_APP_NAME="HireSphere AI"
VITE_APP_TAGLINE="Autonomous Real-Time Talent & Placement Platform"
VITE_APP_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 2. NETWORK PORTS & HOST SETTINGS
# ------------------------------------------------------------------------------
VITE_PORT=5175
VITE_BACKEND_PORT=8085

# ------------------------------------------------------------------------------
# 3. CENTRALIZED API & REAL-TIME URLS
# ------------------------------------------------------------------------------
# Primary REST API Gateway (proxied through Vite to port 8085)
VITE_API_BASE_URL=/api

# Live Server-Sent Events (SSE) stream for instant real-time sync
VITE_REALTIME_STREAM_URL=/api/realtime/stream

# Interactive OpenAPI / Swagger Documentation
VITE_SWAGGER_URL=http://localhost:8085/swagger-ui.html

# Embedded Database Web Console
VITE_H2_CONSOLE_URL=http://localhost:8085/h2-console

# ------------------------------------------------------------------------------
# 4. STORAGE & AUTH KEYS
# ------------------------------------------------------------------------------
VITE_AUTH_TOKEN_KEY=hiresphere_token
VITE_AUTH_USER_KEY=hiresphere_user

# ------------------------------------------------------------------------------
# 5. FEATURE FLAGS & TOGGLES
# ------------------------------------------------------------------------------
VITE_ENABLE_REALTIME_EVENTS=true
VITE_ENABLE_AI_MOCK_INTERVIEW=true
VITE_ENABLE_AI_CANDIDATE_SCREENING=true
VITE_ENABLE_AI_JOB_GENERATOR=true

# ------------------------------------------------------------------------------
# 6. SUPABASE INTEGRATION (OTP AUTH & REALTIME POSTGRESQL)
# ------------------------------------------------------------------------------
# Set your project URL and anon public key from https://app.supabase.com
VITE_SUPABASE_URL=https://esbvwqjdabcmbqubfffi.supabase.co
